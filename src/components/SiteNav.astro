---
import Menu from './Menu.astro';
import Navigation from './Navigation.astro';
import ThemeIcon from './ThemeIcon.astro';
import LangToggle from './LangToggle.astro';
---

<nav
  class="site-nav sticky top-0 z-[60] w-full border-b"
  style="border-color: var(--color-border-main); background-color: color-mix(in srgb, var(--color-bg-primary) 92%, transparent); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);"
>
  <div class="max-w-7xl mx-auto px-6 md:px-12 flex flex-col md:flex-row md:items-center md:justify-between py-4 md:py-5">
    <div class="flex items-center justify-between w-full md:w-auto">
      <a
        href="/"
        class="font-serif text-lg tracking-widest uppercase font-medium transition-colors duration-200"
        style="color: var(--color-text-main); font-family: var(--font-serif);"
        onmouseover="this.style.color='var(--color-accent)'"
        onmouseout="this.style.color='var(--color-text-main)'"
      >
        Casa Toro
      </a>
      <div class="flex items-center gap-3">
        <ThemeIcon />
        <LangToggle />
        <Menu />
      </div>
    </div>
    <Navigation />
  </div>
</nav>
