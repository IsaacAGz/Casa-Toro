---
import Menu from './Menu.astro';
import Navigation from './Navigation.astro';
import ThemeIcon from './ThemeIcon.astro';
import LangToggle from './LangToggle.astro';
---

<header class="site-nav sticky top-0 z-[60] w-full border-b"
  style="border-color: var(--color-border-main); background-color: color-mix(in srgb, var(--color-bg-primary) 92%, transparent); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);"
>
  <div class="max-w-7xl mx-auto px-6 md:px-12 flex items-center justify-between py-4 md:py-5">
    <a
      href="/"
      class="site-logo font-display text-2xl leading-none transition-colors duration-200"
      style="color: var(--color-text-title);"
    >
      Casa Toro
    </a>
    <div class="flex items-center gap-2">
      <ThemeIcon />
      <LangToggle />
      <Menu />
    </div>
  </div>
</header>

<Navigation />
