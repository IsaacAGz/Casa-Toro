---
const { locale = 'en' } = Astro.props;

const copy = locale === 'es'
  ? [
      {
        title: 'El Entorno',
        body: 'Situado sobre colinas de granito privado flanqueadas por antiguos viñedos entre Tecate y Ensenada.',
      },
      {
        title: 'El Santuario',
        body: 'Diseñado con imponentes muros de concreto, maderas curadas, jacuzzi infinito de piedra y terraza de observación estelar.',
      },
      {
        title: 'El Horizonte',
        body: 'Acceso inmediato a un entorno rústico y campestre, perfecto para escapes de la vida ocupada de la ciudad, ofreciendo un ambiente tranquilo y familiar.',
      },
    ]
  : [
      {
        title: 'The Setting',
        body: 'Perched on private boulder ridges flanked by old-growth vineyard rows between Tecate and Ensenada.',
      },
      {
        title: 'The Sanctuary',
        body: 'Featuring modern concrete features, raw structural timbers, custom stone infinity hot tub, and stargazing deck.',
      },
      {
        title: 'The Horizon',
        body: 'Direct access to mountain off-road motorcycle loops, tactical rifle lines, and archery target fields.',
      },
    ];
---

<section class="overview-strip select-none focus:outline-none font-sans">
  <div class="overview-strip-inner grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-16 lg:gap-20 px-8 md:px-12 lg:px-16 py-14 md:py-16 text-center md:text-left">
    {copy.map((item) => (
      <div>
        <h4 class="overview-title font-display m-0 mb-4 uppercase tracking-[0.12em]">
          {item.title}
        </h4>
        <p class="overview-body m-0 leading-loose">
          {item.body}
        </p>
      </div>
    ))}
  </div>
</section>

<style>
  .overview-strip {
    width: 100vw;
    max-width: 100vw;
    margin: 0 calc(50% - 50vw);
    background-color: #a65d3f;
    overflow-x: clip;
  }

  .overview-strip-inner {
    max-width: 80rem;
    margin-left: auto;
    margin-right: auto;
  }

  .overview-title {
    font-size: 1rem;
    color: #f7efe4;
  }

  .overview-body {
    font-size: 1.05rem;
    color: #f3e6d6;
  }

  :global(.dark) .overview-strip {
    background-color: #8f4a2e;
  }

  :global(.dark) .overview-title {
    color: #f7efe4;
  }

  :global(.dark) .overview-body {
    color: #ebd9c4;
  }
</style>
