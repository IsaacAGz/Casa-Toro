---
const { locale = 'en' } = Astro.props;

const copy = locale === 'es'
  ? [
      {
        title: 'El Entorno',
        body: 'Situado sobre colinas de granito privado flanqueadas por antiguos viñedos entre Tecate y Ensenada.',
      },
      {
        title: 'El Santuario',
        body: 'Diseñado con imponentes muros de concreto, maderas curadas, jacuzzi infinito de piedra y terraza de observación estelar.',
      },
      {
        title: 'El Horizonte',
        body: 'Acceso inmediato a un entorno rústico y campestre, perfecto para escapes de la vida ocupada de la ciudad, ofreciendo un ambiente tranquilo y familiar.',
      },
    ]
  : [
      {
        title: 'The Setting',
        body: 'Perched on private boulder ridges flanked by old-growth vineyard rows between Tecate and Ensenada.',
      },
      {
        title: 'The Sanctuary',
        body: 'Featuring modern concrete features, raw structural timbers, custom stone infinity hot tub, and stargazing deck.',
      },
      {
        title: 'The Horizon',
        body: 'Direct access to mountain off-road motorcycle loops, tactical rifle lines, and archery target fields.',
      },
    ];
---

<section
  class="overview-strip select-none focus:outline-none grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-0 py-12 md:py-14 my-8 md:my-10 font-sans text-center md:text-left"
  style="border-top: 1px solid var(--color-border-main); border-bottom: 1px solid var(--color-border-main);"
>
  {copy.map((item, i) => (
    <div
      class:list={[
        'px-0 md:px-8',
        i === 1 && 'border-y md:border-y-0 md:border-x py-6 md:py-0',
        i === 2 && 'md:pl-8',
        i === 0 && 'md:pl-0 md:pr-8',
      ]}
      style="border-color: var(--color-border-main);"
    >
      <h4
        class="text-[10px] uppercase tracking-[0.2em] font-semibold m-0 mb-3"
        style="color: var(--color-text-light);"
      >
        {item.title}
      </h4>
      <p
        class="text-sm m-0 leading-relaxed"
        style="color: var(--color-text-muted);"
      >
        {item.body}
      </p>
    </div>
  ))}
</section>
