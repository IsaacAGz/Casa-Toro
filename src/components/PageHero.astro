---
const {
  eyebrow = '',
  title,
  subtitle = '',
  image,
} = Astro.props;
---

<section
  class="page-hero w-full min-h-[50vh] md:min-h-[65vh] flex flex-col justify-center relative"
  style={`background-image: url('${image}'); background-repeat: no-repeat; background-size: cover; background-position: center;`}
  aria-label={title}
>
  <div
    class="page-hero-scrim absolute inset-0"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 px-6 md:px-12 py-20 md:py-28 text-center max-w-4xl mx-auto select-none">
    {eyebrow && (
      <div class="flex items-center justify-center gap-3 mb-4">
        <span class="w-8 h-px" style="background-color: var(--color-border-main);"></span>
        <span
          class="text-[10px] tracking-widest uppercase font-sans font-semibold"
          style="color: var(--color-text-light);"
        >
          {eyebrow}
        </span>
        <span class="w-8 h-px" style="background-color: var(--color-border-main);"></span>
      </div>
    )}

    <h1
      class="font-serif text-4xl md:text-6xl font-light tracking-wide m-0 mb-6 uppercase"
      style="color: var(--color-text-title);"
    >
      {title}
    </h1>

    {subtitle && (
      <p
        class="font-serif italic text-lg md:text-xl leading-relaxed max-w-2xl mx-auto m-0"
        style="color: var(--color-text-muted);"
      >
        {subtitle}
      </p>
    )}
  </div>
</section>

<style>
  .page-hero-scrim {
    background: linear-gradient(
      to bottom,
      rgba(235, 227, 212, 0.55) 0%,
      rgba(235, 227, 212, 0.72) 55%,
      rgba(235, 227, 212, 0.88) 100%
    );
  }

  :global(.dark) .page-hero-scrim {
    background: linear-gradient(
      to bottom,
      rgba(22, 17, 14, 0.55) 0%,
      rgba(22, 17, 14, 0.72) 55%,
      rgba(22, 17, 14, 0.9) 100%
    );
  }
</style>
