---
import Social from './Social.astro';

const locale = Astro.url.pathname.startsWith('/es') ? 'es' : 'en';

const platforms = [
  { name: 'Instagram', username: 'casatorovalle' },
  { name: 'Github', username: 'IsaacAGz' },
];

const copy = locale === 'es'
  ? {
      line: 'Un refugio de arquitectura en las colinas de roca del Valle de Guadalupe.',
      cabin: 'La cabaña',
      experiences: 'Experiencias',
      route: 'Cómo llegar',
      inquiries: 'Consultas',
      privacy: 'Privacidad',
      terms: 'Términos',
      rights: 'Todos los derechos reservados.',
      navLabel: 'Pie de página',
    }
  : {
      line: 'A refined architectural escape in the boulder hills of Valle de Guadalupe.',
      cabin: 'The cabin',
      experiences: 'Experiences',
      route: 'The route',
      inquiries: 'Inquiries',
      privacy: 'Privacy',
      terms: 'Terms',
      rights: 'All rights reserved.',
      navLabel: 'Footer',
    };

const prefix = `/${locale}`;
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <p class="site-footer-mark">Casa Toro</p>
    <p class="site-footer-line">{copy.line}</p>
    <nav class="site-footer-links" aria-label={copy.navLabel}>
      <a href={`${prefix}/about`}>{copy.cabin}</a>
      <a href={`${prefix}/experiences`}>{copy.experiences}</a>
      <a href={`${prefix}/location`}>{copy.route}</a>
      {platforms.map((p) => (
        <Social platform={p.name} username={p.username} />
      ))}
      <a href="mailto:isaac.angulogomez@gmail.com">{copy.inquiries}</a>
    </nav>
    <div class="site-footer-meta">
      <p>&copy; {new Date().getFullYear()} Valle Cabin Retreat. {copy.rights}</p>
      <div class="site-footer-legal">
        <a href="/privacy">{copy.privacy}</a>
        <a href="/terms">{copy.terms}</a>
      </div>
    </div>
  </div>
</footer>
