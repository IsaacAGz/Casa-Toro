---
const { locale = 'en' } = Astro.props;

const copy = locale === 'es'
  ? {
      bands: [
        {
          eyebrow: 'La cabaña',
          headline: 'Brutalismo puro y calidez del desierto',
          body: 'Casa Toro fue concebida como un santuario monolítico. Combinando la fuerza industrial del concreto enduelado y el acero corten oxidado con las texturas orgánicas de la piedra local y maderas en bruto, la cabaña emula el entorno de las colinas de Baja California. Los ventanales de piso a techo disuelven la frontera entre el confort interior y la imponente naturaleza del valle.',
          image: '/images/Valle-View.jpeg',
          alt: 'Detalles arquitectónicos de concreto moderno',
          reverse: false,
        },
        {
          eyebrow: 'El valle',
          headline: 'La cuna del vino en Baja',
          body: 'Ubicada estratégicamente en la ruta del vino entre Tecate y Ensenada, el Valle de Guadalupe ofrece un microclima único donde las brisas marinas cruzan las montañas de granito para encontrarse con tierras celosamente cuidadas. Casa Toro se eleva sobre este ecosistema, ofreciendo vistas panorámicas despejadas a los olivares centenarios y los viñedos privados de la región.',
          image: '/images/Bull.jpg',
          alt: 'Colinas de viñedos en Baja',
          reverse: true,
        },
      ],
      philosophyEyebrow: 'Nuestra filosofía',
      quote: 'Creemos que el lujo no se trata de excesos. Se trata de quietud, espacio, cielos nocturnos despejados, el rugir de un motor en caminos de tierra y una copa perfecta de vino local junto al fuego.',
      cta: 'Ver experiencias',
      href: '/es/experiences',
    }
  : {
      bands: [
        {
          eyebrow: 'The cabin',
          headline: 'Raw brutalism meets desert warmth',
          body: 'Casa Toro was conceived as a monolithic sanctuary. Combining the industrial edge of board-formed concrete and weathered Corten steel with the organic textures of local stone and rough-sawn timbers, the cabin echoes the rugged textures of the Baja hills. Floor-to-ceiling glass panels dissolve the boundary between the interior comfort and the wild, sweeping valley below.',
          image: '/images/Valle-View.jpeg',
          alt: 'Modern concrete architectural details',
          reverse: false,
        },
        {
          eyebrow: 'The valley',
          headline: 'The cradle of Baja wine',
          body: 'Tucked neatly along the wine route between Tecate and Ensenada, Valle de Guadalupe offers a unique macroclimate where maritime breezes roll over the granite mountains to meet sun-baked soils. Casa Toro stands elevated over this vibrant ecosystem, offering panoramic, unobstructed views of centuries-old olive groves and sweeping, private estate vineyards.',
          image: '/images/Bull.jpg',
          alt: 'Vineyard hillsides in Baja',
          reverse: true,
        },
      ],
      philosophyEyebrow: 'Our philosophy',
      quote: 'We believe that luxury is not about excess. It is about stillness, space, clear night skies, the roar of an engine on dirt roads, and a perfect glass of local wine by the fire.',
      cta: 'Explore activities',
      href: '/en/experiences',
    };
---

<div class="about-story">
  <div class="feature-bleed">
    {copy.bands.map((band) => (
      <section class:list={['feature-block', { 'feature-block--reverse': band.reverse }]}>
        <div class="feature-media">
          <img src={band.image} alt={band.alt} loading="lazy" />
        </div>
        <div class="feature-copy">
          <span class="feature-eyebrow">{band.eyebrow}</span>
          <h2 class="feature-headline">{band.headline}</h2>
          <p class="feature-body">{band.body}</p>
        </div>
      </section>
    ))}
  </div>

  <section class="philosophy-band">
    <div class="philosophy-band-inner">
      <span class="philosophy-eyebrow">{copy.philosophyEyebrow}</span>
      <p class="philosophy-quote">“{copy.quote}”</p>
    </div>
  </section>

  <div class="about-close">
    <a class="feature-cta" href={copy.href}>{copy.cta}</a>
  </div>
</div>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const revealBands = () => {
    document.querySelectorAll('.about-story .feature-block').forEach((el) => {
      if (el instanceof HTMLElement && el.dataset.observed === 'true') return;
      if (!(el instanceof HTMLElement)) return;
      el.dataset.observed = 'true';

      if (reduceMotion.matches) {
        el.classList.add('is-visible');
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.18, rootMargin: '0px 0px -48px 0px' }
      );

      observer.observe(el);
    });
  };

  revealBands();
  document.addEventListener('astro:page-load', revealBands);
</script>
