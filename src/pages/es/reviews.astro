---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ReviewBoard from '../../components/ReviewBoard.vue';

const pageTitle = "Diario de Huéspedes";
---

<BaseLayout pageTitle={pageTitle}>
  <PageHero
    slot="hero"
    eyebrow="Voces de Huéspedes"
    title="Diario de Huéspedes"
    subtitle="Historias e impresiones de estadías en Casa Toro — mañanas quietas, luz del valle y noches bajo el cielo de Baja."
    image="/images/placeholders/vineyard-deck.jpg"
  />

  <div class="py-6 px-2">
    <ReviewBoard client:load />
  </div>
</BaseLayout>
