---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import AboutStory from '../../components/AboutStory.astro';

const pageTitle = "Nuestra Historia — Casa Toro";
---

<BaseLayout pageTitle={pageTitle}>
  <PageHero
    slot="hero"
    eyebrow="Concepto Arquitectónico"
    title="El Alma de Casa Toro"
    subtitle='"Diseñado no para irrumpir en el paisaje, sino para habitar silenciosamente en él."'
    image="/images/placeholders/cabin-interior.jpg"
  />

  <AboutStory locale="es" />
</BaseLayout>
