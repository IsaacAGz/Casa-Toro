---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IndexLayout from '../../layouts/IndexLayout.astro';
import ExperienceGridEs from '../../components/ExperienceGridEs.vue';
import GalleryDisplayEs from '../../components/GalleryDisplay.vue';

const pageTitle = "Casa Toro — Refugio de Lujo Rústico";
---

<IndexLayout pageTitle={pageTitle}>

  <!-- --- MATRIZ DE RESUMEN DEL REFUGIO --- -->
  <section class="select-none focus:outline-none grid grid-cols-1 md:grid-cols-3 gap-8 py-10 my-12 font-sans text-center md:text-left" style="border-top: 1px solid var(--color-border-main); border-bottom: 1px solid var(--color-border-main);">
    <div>
      <h4 class="text-[11px] uppercase tracking-widest font-bold m-0 mb-1" style="color: var(--color-text-main:);">El Entorno</h4>
      <p class="text-sm m-0 leading-relaxed" style="color: var(--color-text-muted);">Situado sobre colinas de granito privado flanqueadas por antiguos viñedos entre Tecate y Ensenada.</p>
    </div>
    <div class="border-y md:border-y-0 md:border-x py-6 md:py-0 md:px-8" style="border-color: var(--color-border-main);">
      <h4 class="text-[11px] uppercase tracking-widest font-bold m-0 mb-1" style="color: var(--color-text-main:);">El Santuario</h4>
      <p class="text-sm m-0 leading-relaxed" style="color: var(--color-text-muted);">Diseñado con imponentes muros de concreto, maderas curadas, jacuzzi infinito de piedra y terraza de observación estelar.</p>
    </div>
    <div class="md:pl-4">
      <h4 class="text-[11px] uppercase tracking-widest font-bold m-0 mb-1" style="color: var(--color-text-main:);">El Horizonte</h4>
      <p class="text-sm m-0 leading-relaxed" style="color: var(--color-text-muted);">Acceso inmediato a un entorno rústico y campestre, perfecto para escapes de la vida ocupada de la ciudad, ofreciendo un ambiente tranquilo y familiar.</p>
    </div>
  </section>

  <!-- GALLERY SECTION -->
  <GalleryDisplayEs client:visible />

  <!-- --- CUADRÍCULA DE EXPERIENCIAS EN ESPAÑOL --- -->
  <ExperienceGridEs client:visible />

</IndexLayout>