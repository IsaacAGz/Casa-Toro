---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ExperienceGrid from '../../components/ExperienceGridEs.vue';
const pageTitle = "Experiences";
---

<BaseLayout pageTitle={pageTitle}>
	<PageHero
		slot="hero"
		eyebrow="Baja California, México"
		title="Retiro Rústico, Lujo Refinado"
		subtitle="Un retiro moderno ubicado entre las colinas rocosas entre Tecate y Ensenada."
		image="/images/placeholders/fireside-night.jpg"
	/>

	<ExperienceGrid client:visible />
</BaseLayout>
