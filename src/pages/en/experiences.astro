---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ExperienceGrid from '../../components/ExperienceGrid.vue';
const pageTitle = "Experiences — Casa Toro";
---

<BaseLayout pageTitle={pageTitle}>
	<PageHero
		slot="hero"
		eyebrow="Baja California, Mexico"
		title="Rustic Retreat, Refined Luxury"
		subtitle="A modern architectural retreat carved into the stunning boulder hillsides between Tecate and Ensenada."
		image="/images/placeholders/fireside-night.jpg"
	/>

	<ExperienceGrid client:visible />
</BaseLayout>
