---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import AboutStory from '../../components/AboutStory.astro';

const pageTitle = "Our Story";
---

<BaseLayout pageTitle={pageTitle}>
  <PageHero
    slot="hero"
    eyebrow="Architectural Concept"
    title="The Soul of Casa Toro"
    subtitle='"Built not to disrupt the landscape, but to sit quietly within it."'
    image="/images/placeholders/cabin-interior.jpg"
  />

  <AboutStory locale="en" />
</BaseLayout>
