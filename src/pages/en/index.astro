---
import IndexLayout from '../../layouts/IndexLayout.astro';
import OverviewStrip from '../../components/OverviewStrip.astro';
import FeatureSections from '../../components/FeatureSections.vue';
import GalleryDisplay from '../../components/GalleryDisplay.vue';

const pageTitle = "Casa Toro";
---

<IndexLayout pageTitle={pageTitle}>

  <OverviewStrip locale="en" />

  <FeatureSections client:visible locale="en" />

  <section class="gallery-section py-16 md:py-20">
    <div class="mb-8 md:mb-10">
      <span class="text-[10px] tracking-[0.2em] uppercase font-sans font-semibold block mb-2" style="color: var(--color-text-light);">
        The Property
      </span>
      <h2 class="font-serif text-3xl md:text-4xl font-light tracking-wide m-0 uppercase border-0 pb-0" style="color: var(--color-text-title);">
        Gallery
      </h2>
    </div>
    <GalleryDisplay client:visible />
  </section>

</IndexLayout>
