---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
const pageTitle = "The Route";

const TIMELAPSE_VIDEO_ID = "dQw4w9WgXcQ"; 
---

<BaseLayout pageTitle={pageTitle}>
  <PageHero
    slot="hero"
    eyebrow="The Journey"
    title="The Route"
    subtitle="Located in the rugged heart of the Valle de Guadalupe, perched between Tecate and Ensenada. Watch our cinematic route preview below to prepare for your arrival."
    image="/images/placeholders/trail-dust.jpg"
  />

  <section class="route-video">
    <div class="experience-panel experience-panel--still">
      <div class="experience-panel-media route-video-media">
        <iframe
          src={`https://www.youtube.com/embed/${TIMELAPSE_VIDEO_ID}?rel=0&modestbranding=1`}
          title="Casa Toro Route Timelapse"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
    </div>
    <p class="route-caption">Route preview: Scenic Highway 3 into the boulder highlands</p>
  </section>

  <section class="route-guide">
    <div class="route-notes">
      <div>
        <h2 class="route-heading">From Tecate, the north route</h2>
        <p class="route-copy">
          Take Federal Highway 3 South towards Ensenada. You will wind down through spectacular high-desert valleys. Keep a watch out for the  markers near kilometer marker 55, where you will exit to the left onto our unpaved trail towards ranch El Fresno.
        </p>
      </div>
      <div>
        <h2 class="route-heading">From Ensenada, the coast route</h2>
        <p class="route-copy">
          Head North on Federal Highway 3 entering the Valle de Guadalupe. Pass through the main wine tasting village corridors. As the road climbs up towards the rocky ridges, right after the kilometer marker 56 look for our entrance gate flanking to the right of the road toward ranch El Fresno.
        </p>
      </div>
    </div>

    <aside class="advisory-panel">
      <span class="feature-eyebrow">Traveler advisory</span>
      <p class="route-copy">
        While Highway 3 is smoothly paved, the final 1.5 kilometers approaching Casa Toro consists of a graded, rustic dirt mountain trail to maintain total isolation.
      </p>
      <div class="advisory-meta">
        <span>Recommended vehicle</span>
        <span>Crossover / SUV or dual-sport bike</span>
      </div>
    </aside>
  </section>

</BaseLayout>
